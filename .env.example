# Shop configuration — copy to `.env` and adjust. Never commit the real `.env` file.

# Database password (generate one: openssl rand -hex 24)
DB_PASSWORD=change-me-to-a-long-random-password

# Optional. Leave empty to let the backend generate and persist a random signing key.
# If set, it must be at least 32 characters.
JWT_SECRET=

# Optional initial password for the first admin account (min. 12 characters).
# If empty, a random password is printed once in the backend log.
ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------- domains
# Public URLs (canonical links, sitemap, emails, Stripe return URLs). Use https:// in production.
# Any (sub)domains work, e.g. https://example.com + https://admin.example.com
# or https://shop.example.com + https://admin.shop.example.com
SHOP_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:4000

# Built-in HTTPS proxy (Caddy with automatic Let's Encrypt certificates):
#   COMPOSE_PROFILES=proxy, set both domains below and PUBLISH_ADDR=127.0.0.1
# These values can also be set from Admin → Settings → System & Updates.
COMPOSE_PROFILES=
SHOP_DOMAIN=
ADMIN_DOMAIN=

# Address the shop (8080) and admin (4000) ports listen on.
# 0.0.0.0 = reachable from the network; 127.0.0.1 = only via a reverse proxy on this server.
PUBLISH_ADDR=0.0.0.0
STOREFRONT_PORT=8080
ADMIN_PORT=4000

RUST_LOG=info
